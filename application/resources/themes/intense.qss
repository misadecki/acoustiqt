QWidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: "Sans Serif", sans-serif;
    font-size: 13px;
}

QWidget#page_3 {
    background-color: transparent;
}

QFrame#theme_frame {
    background-color: rgba(0, 72, 178, 120); /* Bezpieczny niebieski */
    border-radius: 10px;
}

QWidget#statistics_widget {
    background-color: #005AB5; /* Wyrazisty, bezpieczny niebieski */
    border: 2px solid #E69F00; /* Jaskrawy pomarańczowy kontrast */
    border-radius: 5px;
}

QWidget#statistics_widget QLabel {
    background-color: transparent; 
    font-family: "Blockletter", sans-serif;
    font-size: 16px;
    color: #FFFFFF; 
}

QWidget#page_3 QPushButton,
QWidget#page_3 QLabel,
QFrame#theme_frame QPushButton,
QFrame#theme_frame QLabel {
    font-family: "Blockletter", sans-serif;
    font-size: 30px;
}

QLabel#theme_label {
    background-color: #0048B3; 
    border: 2px solid #F0E442; /* Jaskrawy żółty element */
    border-radius: 5px;
    padding: 6px;
    color: #FFFFFF;
}

QLineEdit {
    background-color: #111111;
    border: 2px solid #0072B2;
    border-radius: 3px;
    padding: 4px;
    color: #321052;
}

QPushButton {
    background-color: qlineargradient(spread:pad, x1:0.495, y1:1, x2:0.493165, y2:0.004, stop:0 #222222, stop:1 #444444);
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    padding: 2px 2px;
    color: #FFFFFF;
    outline: none; 
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #F0E442, stop:1 #E69F00);
    border-color: #FFFFFF;
    color: #000000; /* Czarny tekst na jasnym tle dla idealnego kontrastu */
}

QPushButton:pressed {
    background-color: #D55E00;
    color: #FFFFFF;
}

QPushButton#btn_dark {
    color: #000000;
    background-color: #F0E442;
}

QSlider::add-page:vertical {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
        stop:0 #F0E442,
        stop:0.5 #0072B2,
        stop:1 #000000);
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background-color: #222222;
    border: 1px solid #555555;
    border-radius: 3px;
}
